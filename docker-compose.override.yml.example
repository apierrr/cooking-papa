# Exemple d'override local (à copier en docker-compose.override.yml, non versionné).
#
# Cas d'usage : l'application est servie par un reverse-proxy ou un tunnel qui
# tourne lui-même en conteneur. Elle n'a alors aucune raison de publier un port
# sur l'hôte — le proxy l'atteint par son nom sur un réseau partagé.
#
# `!reset` efface la liste `ports` du compose versionné au lieu de s'y ajouter
# (Docker Compose 2.24 et plus).
services:
  cooking-papa:
    ports: !reset []
    networks:
      - proxy_net     # réseau partagé avec le reverse-proxy / tunnel
      - discord_net   # facultatif : pour joindre le bot par son nom de service

networks:
  proxy_net:
    external: true
    name: nom-de-ton-reseau-proxy
  discord_net:
    external: true
    name: nom-du-reseau-du-bot
